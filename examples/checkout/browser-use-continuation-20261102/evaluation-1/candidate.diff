--- clean/style.css
+++ candidate/style.css
@@ -32,3 +32,19 @@
 .total { font-size: 23px; font-weight: 700; border-top: 1px solid #d8e0e5; margin-top: 20px; padding-top: 20px; }
 .footnote { font-size: 13px; color: #53636e; margin-top: 28px; }
 .order-line { display: flex; justify-content: space-between; gap: 30px; padding: 10px 0; }
+.option-stage { margin-top: 24px; }
+.option-stage .page-heading { margin-bottom: 10px; }
+.option-stage .context { margin-bottom: 16px; }
+.choice-layout { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: 24px; align-items: stretch; }
+.delivery-panel { padding: 24px; }
+.case-feature { background: #fff1d9; border: 2px solid #bb7317; border-radius: 12px; padding: 20px 24px; }
+.case-feature h2 { margin-bottom: 6px; }
+.case-feature p { font-size: 14px; margin-bottom: 8px; color: #664517; }
+.case-art { height: 96px; position: relative; }
+.case-handle { position: absolute; width: 70px; height: 28px; left: calc(50% - 35px); top: 0; border: 7px solid #77542c; border-bottom: 0; border-radius: 16px 16px 0 0; }
+.case-body { position: absolute; width: 160px; height: 75px; top: 18px; left: calc(50% - 80px); background: #b78548; border: 5px solid #77542c; border-radius: 20px; box-shadow: 0 5px 8px #dfc49c; }
+.case-select .choice { background: #fff; border: 2px solid #9c6115; margin: 8px 0 0; padding: 16px; font-size: 20px; font-weight: 700; align-items: center; }
+.case-select .choice input { width: 28px; height: 28px; margin: 0; accent-color: #9c6115; }
+.other-options { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: 24px; margin-top: 16px; }
+.other-options .choice { background: #fff; font-size: 14px; margin-bottom: 0; }
+.option-stage .actions { margin-top: 16px; }
