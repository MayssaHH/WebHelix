 .ear-right { left: 59%; }
 .product-info { display: flex; flex-direction: column; justify-content: center; }
 .price { font-size: 28px; font-weight: 700; margin: 16px 0; }
-.options-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
+.options-layout { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 3fr); gap: 24px; align-items: stretch; }
 .context { color: #53636e; margin-bottom: 20px; }
+.featured-option { background: #edf5f8; border: 2px solid #426f83; padding: 26px; }
+.featured-option h2 { font-size: 26px; }
+.featured-choice { margin-top: 24px; }
+.featured-choice .choice { background: #fff; border: 2px solid #426f83; padding: 20px; font-size: 20px; font-weight: 700; }
+.featured-choice .choice input { width: 26px; height: 26px; }
+.fact-emphasis { font-size: 16px; color: #294a5b; }
+.secondary-options { margin-top: 24px; }
 .choice { display: flex; align-items: flex-start; gap: 12px; margin: 0 0 18px; padding: 12px; border: 1px solid #d8e0e5; border-radius: 8px; }
 .choice input { width: 20px; height: 20px; margin: 3px 0 0; flex-shrink: 0; }
 .choice .detail { display: block; color: #53636e; font-size: 14px; }
