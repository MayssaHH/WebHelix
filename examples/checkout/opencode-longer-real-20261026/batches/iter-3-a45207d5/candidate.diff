--- clean/style.css
+++ candidate/style.css
@@ -32,3 +32,17 @@
 .total { font-size: 23px; font-weight: 700; border-top: 1px solid #d8e0e5; margin-top: 20px; padding-top: 20px; }
 .footnote { font-size: 13px; color: #53636e; margin-top: 28px; }
 .order-line { display: flex; justify-content: space-between; gap: 30px; padding: 10px 0; }
+.accessory-banner { background: #fff1ce; border: 2px solid #a66b12; border-radius: 12px; padding: 16px 24px; margin-top: 20px; color: #49320d; }
+.accessory-banner h2 { margin-bottom: 5px; font-size: 22px; }
+.accessory-banner p { margin-bottom: 4px; font-size: 20px; font-weight: 700; }
+.accessory-banner .accessory-notice { font-size: 14px; font-weight: 400; }
+.exposure-shell { margin-top: 20px; }
+.exposure-shell .page-heading { margin-bottom: 8px; }
+.exposure-shell .context { margin-bottom: 12px; }
+.accessory-selection { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; align-items: center; margin: 0 0 18px; padding: 20px 24px; }
+.accessory-control .choice { margin: 0; background: #fff; border: 2px solid #a66b12; font-size: 22px; font-weight: 700; padding: 20px; align-items: center; }
+.accessory-control .choice input { width: 26px; height: 26px; accent-color: #a66b12; margin-top: 0; }
+.compact-options .panel { padding: 18px; }
+.compact-options h2 { font-size: 20px; margin-bottom: 12px; }
+.compact-options .choice { margin-bottom: 10px; padding: 10px; }
+.exposure-shell .actions { margin-top: 18px; }
