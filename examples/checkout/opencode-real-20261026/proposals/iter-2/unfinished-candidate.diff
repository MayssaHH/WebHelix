--- accepted/style.css
+++ unfinished/style.css
@@ -32,3 +32,25 @@
 .total { font-size: 23px; font-weight: 700; border-top: 1px solid #d8e0e5; margin-top: 20px; padding-top: 20px; }
 .footnote { font-size: 13px; color: #53636e; margin-top: 28px; }
 .order-line { display: flex; justify-content: space-between; gap: 30px; padding: 10px 0; }
+.case-banner { display: flex; align-items: center; gap: 28px; background: #d9f1eb; border: 2px solid #27816d; border-radius: 12px; padding: 20px 28px; margin-top: 22px; }
+.case-banner h2 { font-size: 16px; margin-bottom: 4px; }
+.case-banner p { margin: 4px 0 0; font-size: 14px; }
+.case-fact { font-size: 23px; font-weight: 700; }
+.case-icon { width: 96px; height: 64px; flex-shrink: 0; background: #286c5e; border: 6px solid #143f37; border-radius: 22px; box-shadow: inset 0 0 0 3px #6fae9c; }
+.case-options { margin-top: 22px; }
+.case-options .page-heading { margin-bottom: 8px; }
+.case-options .context { margin-bottom: 14px; }
+.case-layout { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
+.case-feature { padding: 24px; background: #d9f1eb; border: 2px solid #27816d; border-radius: 12px; }
+.case-feature h2 { margin-bottom: 6px; }
+.case-feature p { font-size: 14px; }
+.case-art { height: 145px; display: flex; align-items: center; justify-content: center; }
+.case-art .case-icon { width: 200px; height: 124px; border-width: 10px; border-radius: 36px; }
+.case-select .choice { background: #fff; border: 2px solid #27816d; padding: 20px; font-size: 24px; font-weight: 700; margin: 16px 0 0; }
+.case-select .choice input { width: 26px; height: 26px; margin-top: 5px; }
+.case-sidebar { display: flex; flex-direction: column; gap: 14px; }
+.case-sidebar .panel { padding: 18px; }
+.case-sidebar h2 { font-size: 18px; margin-bottom: 8px; }
+.case-sidebar .choice { padding: 8px; margin-bottom: 8px; font-size: 14px; }
+.case-sidebar .choice:last-child { margin-bottom: 0; }
+.case-options .actions { margin-top: 18px; }
