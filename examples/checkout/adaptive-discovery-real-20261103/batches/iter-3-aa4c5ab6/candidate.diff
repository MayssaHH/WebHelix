--- clean/style.css
+++ candidate/style.css
@@ -23,6 +23,11 @@
 .choice { display: flex; align-items: flex-start; gap: 12px; margin: 0 0 18px; padding: 12px; border: 1px solid #d8e0e5; border-radius: 8px; }
 .choice input { width: 20px; height: 20px; margin: 3px 0 0; flex-shrink: 0; }
 .choice .detail { display: block; color: #53636e; font-size: 14px; }
+.options-grid .panel:last-child .choice:nth-of-type(3) { border-color: #8a6cff; background: #f7f3ff; }
+.options-grid .panel:last-child .choice:nth-of-type(3) .detail { color: #43305e; }
+.options-grid .panel:last-child { border-color: #b59cff; background: #fbf8ff; }
+.review-panel { border-color: #b59cff; background: #fbf8ff; }
+.review-panel .total { background: #f2ebff; border-radius: 8px; padding: 12px 16px; }
 .muted { color: #53636e; }
 .actions { display: flex; align-items: center; justify-content: space-between; gap: 20px; margin-top: 24px; }
 button, .actions a { border-radius: 7px; padding: 12px 20px; border: 1px solid #526d7d; background: #fff; color: #203b4c; font: inherit; cursor: pointer; text-decoration: none; }
